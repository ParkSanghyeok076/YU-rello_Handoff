# 이 파일을 복사해 같은 폴더에 ".env.local" 이름으로 저장한 뒤 값을 채우세요.
# 값은 Supabase 대시보드 > Project Settings > API Keys (또는 상단 Connect 버튼)에서 복사합니다.
# .env.local 은 Git 에 올라가지 않습니다. 절대 커밋하지 마세요.

NEXT_PUBLIC_SUPABASE_URL=https://<프로젝트ID>.supabase.co
# Publishable key(sb_publishable_...) 또는 legacy anon key 를 넣습니다. secret key 는 넣지 마세요.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
